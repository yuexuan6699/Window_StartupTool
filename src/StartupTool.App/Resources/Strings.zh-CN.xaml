    <sys:String x:Key="Str.ImportConfig.FileFilter">配置文件 (*.json)|*.json|所有文件 (*.*)|*.*</sys:String>
    <sys:String x:Key="Str.ImportConfig.ReadFailed">读取配置文件失败：</sys:String>
