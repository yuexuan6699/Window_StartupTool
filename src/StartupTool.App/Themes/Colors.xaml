<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Fluent 浅色令牌（M5，方案 A：纯手写、无第三方控件库）。
         全部样式只引用这里的键；将来加深色主题时新增同名键的
         Colors.Dark.xaml 并在 App 启动时切换即可，样式无需改动。
         ============================================================ -->

    <!-- 背景层 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FAFAFA" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#FFFFFF" />

    <!-- 文本 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F5F5F" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- 描边/分隔 -->
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="#D1D1D1" />
    <SolidColorBrush x:Key="ControlStrokeHoverBrush" Color="#B3B3B3" />
    <SolidColorBrush x:Key="DividerBrush" Color="#ECECEC" />

    <!-- 强调色（Win11 蓝） -->
    <Color x:Key="AccentColor">#0F6CBD</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1177D9" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0E5FA6" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EAF3FB" />

    <!-- 状态色 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#0E7A0D" />
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#E8F3E8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#D43B2B" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FBEAE8" />
    <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FFF6E0" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#EDF4FC" />

    <!-- 行交互 -->
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F7F9FC" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#E7F1FA" />
    <SolidColorBrush x:Key="RowSelectedInactiveBrush" Color="#F0F0F0" />

    <!-- 字体 -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!-- 圆角/尺寸 -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>
</ResourceDictionary>
