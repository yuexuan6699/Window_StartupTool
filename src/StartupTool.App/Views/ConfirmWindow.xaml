<Window x:Class="StartupTool.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStyle="SingleBorderWindow">
    <StackPanel Margin="24,20,24,16">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <Border x:Name="WarningBox" Margin="0,12,0,0" Padding="10,8" CornerRadius="4"
                Background="{DynamicResource DangerSubtleBrush}"
                BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <TextBlock x:Name="WarningText" TextWrapping="Wrap"
                       Foreground="{DynamicResource DangerBrush}" />
        </Border>
        <CheckBox x:Name="OptionCheckBox" Margin="0,12,0,0"
                  Style="{DynamicResource BaseCheckBox}"
                  Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Style="{DynamicResource SubtleButton}"
                    Width="96" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ConfirmButton" Width="96" IsDefault="True" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
