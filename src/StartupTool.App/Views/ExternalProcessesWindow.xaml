<Window x:Class="StartupTool.App.Views.ExternalProcessesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:StartupTool.App.Converters"
        Title="External" Width="760" Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Padding="10,8" CornerRadius="4" Margin="0,0,0,10"
                Background="{DynamicResource WarningBackgroundBrush}">
            <TextBlock Text="{DynamicResource Str.External.Note}" TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}" />
        </Border>

        <Border DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{DynamicResource SubtleButton}" Width="96" Margin="0,0,8,0"
                        Content="{DynamicResource Str.Common.Refresh}" Command="{Binding RefreshCommand}" />
                <Button x:Name="KillButton" Style="{DynamicResource DangerButton}" Width="150"
                        Content="{DynamicResource Str.External.Kill}" Click="Kill_Click" />
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorText}" TextWrapping="Wrap"
                   Margin="0,10,0,0" Foreground="{DynamicResource DangerBrush}"
                   Visibility="{Binding ErrorText, Converter={StaticResource StringToVis}}" />

        <TextBlock DockPanel.Dock="Bottom" Text="{DynamicResource Str.External.Empty}"
                   Margin="0,10,0,0" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

        <DataGrid x:Name="Grid" ItemsSource="{Binding Processes}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" BorderThickness="1"
                  BorderBrush="{DynamicResource ControlStrokeBrush}"
                  Visibility="{Binding IsEmpty, Converter={StaticResource InvBoolToVis}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Str.External.Pid}" Binding="{Binding Pid}" Width="80" />
                <DataGridTextColumn Header="{DynamicResource Str.External.Process}" Binding="{Binding ProcessName}" Width="160" />
                <DataGridTextColumn Header="{DynamicResource Str.External.Started}" Binding="{Binding StartedText}" Width="160" />
                <DataGridTextColumn Header="{DynamicResource Str.External.Path}" Binding="{Binding ExecutablePath}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
