<Window x:Class="StartupTool.App.Views.OutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Output" Width="820" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <CheckBox Style="{DynamicResource BaseCheckBox}" VerticalAlignment="Center"
                          Content="{DynamicResource Str.Output.AutoScroll}"
                          IsChecked="{Binding AutoScroll}" />
                <Button Style="{DynamicResource SubtleButton}" Margin="12,0,0,0"
                        Content="{DynamicResource Str.Output.Clear}"
                        Command="{Binding ClearCommand}" />
            </StackPanel>
        </Border>

        <Grid>
            <!-- 暗色控制台风格列表（无键默认 ListBox 样式在 Controls.xaml 内定义） -->
            <ListBox x:Name="OutputList" ItemsSource="{Binding Lines}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5" />
            <TextBlock Text="{DynamicResource Str.Output.Empty}"
                       Foreground="#8A8A8A" Margin="10" TextWrapping="Wrap"
                       IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=OutputList}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</Window>
