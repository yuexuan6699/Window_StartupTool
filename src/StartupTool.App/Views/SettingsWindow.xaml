<Window x:Class="StartupTool.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:StartupTool.App.Converters"
        Title="{DynamicResource Str.Settings.Title}" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <conv:StringEqualsConverter x:Key="StringEquals" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>

    <StackPanel Margin="24,20,24,18">
        <TextBlock Text="{DynamicResource Str.Settings.Language}" FontWeight="SemiBold"
                   FontSize="14" Margin="0,0,0,8" />
        <RadioButton Margin="0,4" GroupName="Lang"
                     Content="{DynamicResource Str.Settings.LangSystem}"
                     IsChecked="{Binding SelectedLanguage, Converter={StaticResource StringEquals},
                                 ConverterParameter=system, Mode=TwoWay}" />
        <RadioButton Margin="0,4" GroupName="Lang"
                     Content="{DynamicResource Str.Settings.LangZh}"
                     IsChecked="{Binding SelectedLanguage, Converter={StaticResource StringEquals},
                                 ConverterParameter=zh-CN, Mode=TwoWay}" />
        <RadioButton Margin="0,4" GroupName="Lang"
                     Content="{DynamicResource Str.Settings.LangEn}"
                     IsChecked="{Binding SelectedLanguage, Converter={StaticResource StringEquals},
                                 ConverterParameter=en, Mode=TwoWay}" />

        <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,16" />

        <CheckBox Style="{DynamicResource ToggleSwitchCheckBox}" Margin="0,4"
                  Content="{DynamicResource Str.Settings.NotifyFault}"
                  IsChecked="{Binding NotifyOnFault}" />

        <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,16" />

        <!-- B08：此前全局数值项在界面上无处可改；越界值由服务端 GlobalSettings.Validate 拒绝并在下方红字提示 -->
        <TextBlock Text="{DynamicResource Str.Settings.Advanced}" FontWeight="SemiBold"
                   FontSize="14" Margin="0,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Str.Settings.LogMaxSize}" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBox Style="{StaticResource BaseTextBox}"
                         Text="{Binding LogMaxSizeMb, ValidatesOnExceptions=True}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource Str.Settings.LogRetention}" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBox Style="{StaticResource BaseTextBox}"
                         Text="{Binding LogRetentionDays, ValidatesOnExceptions=True}" />
            </StackPanel>
        </Grid>
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{DynamicResource Str.Settings.CircuitWindow}" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBox Style="{StaticResource BaseTextBox}"
                         Text="{Binding CircuitWindowSeconds, ValidatesOnExceptions=True}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource Str.Settings.CircuitMaxStarts}" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                <TextBox Style="{StaticResource BaseTextBox}"
                         Text="{Binding CircuitMaxStarts, ValidatesOnExceptions=True}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource DangerBrush}"
                   Visibility="{Binding ErrorText, Converter={StaticResource StringToVis}}"
                   x:Name="ErrorTextBlock" />

        <Button Style="{DynamicResource AccentButton}" Width="100" HorizontalAlignment="Right"
                Margin="0,20,0,0" IsCancel="True" IsDefault="True"
                Content="{DynamicResource Str.Common.Close}" />
    </StackPanel>
</Window>
