<Window x:Class="StartupTool.App.Views.TemplatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TemplatePicker" Width="720" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <!-- 列表项模板：名称 + 说明 -->
        <DataTemplate x:Key="TemplateItemTemplate">
            <StackPanel Margin="4,6,8,6">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Str.Template.PickerIntro}"
                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

        <Border Grid.Row="1" Margin="0,14,0,0" Style="{DynamicResource CardBorder}" Padding="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左：模板列表 -->
                <ListBox Grid.Column="0" x:Name="TemplateList" BorderThickness="0"
                         Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemTemplate="{StaticResource TemplateItemTemplate}"
                         SelectionChanged="TemplateList_SelectionChanged" />

                <!-- 右：脚本文本预览（可复制） -->
                <Border Grid.Column="1" BorderThickness="1,0,0,0" Padding="12,10"
                        Background="#F5F5F5" BorderBrush="{DynamicResource ControlStrokeBrush}">
                    <TextBox x:Name="ScriptBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             FontFamily="{DynamicResource MonoFontFamily}"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" />
                </Border>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyButton" Style="{DynamicResource SubtleButton}" Width="100" Margin="0,0,8,0"
                    Content="{DynamicResource Str.Common.Copy}" Click="Copy_Click" />
            <Button Style="{DynamicResource SubtleButton}" Width="96" Margin="0,0,8,0"
                    Content="{DynamicResource Str.Common.Cancel}" IsCancel="True" Click="Cancel_Click" />
            <Button Style="{DynamicResource AccentButton}" Width="96"
                    Content="{DynamicResource Str.Common.Confirm}" IsDefault="True" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
